---
import { Icon } from "astro-icon/components";
import { profile } from "@/config/profile";
---

<section class="card-base profile-widget rise" style="animation-delay: 60ms">
	<div class="card-head">
		<span class="card-head-title">
			<Icon name="fa7-regular:address-card" />
			Profile
		</span>
	</div>

	<div class="avatar">
		<span class="avatar-fallback" aria-hidden="true">
			{profile.name.slice(0, 1)}
		</span>
		<img
			src={profile.avatar}
			alt={`${profile.name} 的头像`}
			width="256"
			height="256"
			loading="eager"
			fetchpriority="high"
			onerror="this.style.display='none'"
		/>
		<span class="avatar-overlay" aria-hidden="true">
			<Icon name="fa7-regular:user" />
		</span>
	</div>

	<div class="widget-body">
		<span class="accent-bar" aria-hidden="true"></span>

		<div class="about">
			{profile.about.map((line) => <p>{line}</p>)}
		</div>

		<div class="tags">
			{profile.tags.map((tag) => <span class="btn-regular tag">{tag}</span>)}
		</div>

		<button class="btn-regular copy-btn" type="button" data-copy-home>
			<Icon name="fa7-regular:copy" />
			<span data-copy-label>复制主页链接</span>
		</button>
	</div>
</section>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>("[data-copy-home]");
	buttons.forEach((button) => {
		const label = button.querySelector<HTMLElement>("[data-copy-label]");
		const original = label?.textContent ?? "";
		button.addEventListener("click", async () => {
			let ok = false;
			try {
				await navigator.clipboard.writeText(window.location.href);
				ok = true;
			} catch (e) {
				ok = false;
			}
			if (label) {
				label.textContent = ok ? "已复制到剪贴板" : "复制失败，请手动复制";
				window.setTimeout(() => {
					label.textContent = original;
				}, 1600);
			}
		});
	});
</script>

<style>
	.profile-widget {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 0 1.25rem 1.375rem;
		text-align: center;
	}
	.profile-widget .card-head {
		padding-inline: 0;
		width: 100%;
	}

	/* 头像：Firefly Profile 的可点图片块，悬停出遮罩 + 图标 */
	.avatar {
		position: relative;
		width: min(100%, 11rem);
		margin-top: 0.375rem;
		aspect-ratio: 1;
		border-radius: var(--radius-xl);
		overflow: hidden;
		background-color: var(--muted);
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: default;
		transition:
			transform var(--duration-normal) var(--ease-standard),
			background-color var(--duration-normal) var(--ease-standard);
	}
	.avatar:hover {
		transform: scale(1.02);
	}
	.avatar:active {
		transform: scale(0.98);
	}
	.avatar img {
		position: relative;
		z-index: 1;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.avatar-fallback {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: "Zen Maru Gothic", inherit;
		font-size: 2.75rem;
		font-weight: 700;
		color: var(--btn-content);
	}
	.avatar-overlay {
		position: absolute;
		inset: 0;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: rgb(0 0 0 / 0.3);
		color: #fff;
		opacity: 0;
		transition:
			opacity var(--duration-normal) var(--ease-standard),
			background-color var(--duration-normal) var(--ease-standard);
	}
	.avatar-overlay :global(svg) {
		font-size: 2.75rem;
		transform: scale(0.9);
		transition: transform var(--duration-normal) var(--ease-standard);
	}
	.avatar:hover .avatar-overlay {
		opacity: 1;
		background-color: rgb(0 0 0 / 0.42);
	}
	.avatar:hover .avatar-overlay :global(svg) {
		transform: scale(1);
	}

	.widget-body {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 100%;
		padding-top: 1.125rem;
	}

	/* Firefly 的强调短条 */
	.accent-bar {
		width: 1.25rem;
		height: 0.25rem;
		border-radius: var(--radius-full);
		background-color: var(--primary);
		margin-bottom: 0.875rem;
	}

	.about {
		margin-bottom: 1rem;
	}
	.about p {
		margin: 0 0 0.375rem;
		font-size: 0.875rem;
		line-height: 1.7;
		color: rgb(0 0 0 / 0.6);
		transition: color var(--duration-normal) var(--ease-standard);
	}
	.about p:last-child {
		margin-bottom: 0;
	}
	:global(.dark) .about p {
		color: rgb(255 255 255 / 0.6);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		margin-bottom: 1.125rem;
	}
	.tag {
		height: 1.75rem;
		padding-inline: 0.625rem;
		border-radius: var(--radius-full);
		font-size: 0.75rem;
		font-weight: 700;
	}

	.copy-btn {
		width: 100%;
		height: 2.5rem;
		border-radius: var(--radius-xl);
		font-size: 0.875rem;
		font-weight: 700;
	}
	.copy-btn :global(svg) {
		width: 0.875rem;
		height: 0.875rem;
	}
	.copy-btn:active {
		transform: scale(0.98);
	}

	@media (min-width: 960px) {
		.profile-widget {
			padding: 0 1.5rem 1.625rem;
		}
		.avatar {
			width: min(100%, 12.5rem);
		}
	}
</style>
