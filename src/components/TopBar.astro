---
import ThemeToggle from "@/components/ThemeToggle.astro";
import { profile } from "@/config/profile";
---

<header class="topbar">
	<div class="topbar-inner glass">
		<a class="brand" href="/" aria-label={`${profile.name} · Lumen`}>
			<img
				class="brand-mark"
				src="/favicon.svg"
				width="20"
				height="20"
				alt=""
				aria-hidden="true"
			/>
			<span class="brand-name">{profile.name}</span>
			<span class="brand-divider" aria-hidden="true"></span>
			<span class="brand-sub">Lumen</span>
		</a>

		<div class="topbar-actions">
			<ThemeToggle />
		</div>
	</div>
</header>

<style>
	.topbar {
		position: fixed;
		inset: 0 0 auto 0;
		z-index: 40;
		pointer-events: none;
		padding: 0.75rem 1rem 0;
	}

	.topbar-inner {
		pointer-events: auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		width: 100%;
		max-width: 68rem;
		margin-inline: auto;
		height: 3.5rem;
		padding-inline: 0.875rem;
		border-radius: var(--radius-large);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
		border-radius: var(--radius-lg);
		padding: 0.25rem 0.375rem;
		margin: -0.25rem -0.375rem;
		transition: background-color var(--duration-normal) var(--ease-standard);
	}
	.brand:hover {
		background-color: var(--btn-plain-bg-hover);
	}
	.brand-mark {
		width: 1.25rem;
		height: 1.25rem;
		border-radius: 0.35rem;
		flex: none;
	}
	.brand-name {
		font-weight: 700;
		font-size: 0.9375rem;
		letter-spacing: 0.01em;
		white-space: nowrap;
	}
	.brand-divider {
		width: 1px;
		height: 0.875rem;
		background-color: var(--line-color);
		flex: none;
	}
	.brand-sub {
		font-size: 0.8125rem;
		color: rgb(0 0 0 / 0.45);
		white-space: nowrap;
	}
	:global(.dark) .brand-sub {
		color: rgb(255 255 255 / 0.45);
	}

	.topbar-actions {
		display: flex;
		align-items: center;
		gap: 0.375rem;
	}

	/* 移动端：贴边留白更小（对应 Firefly <768px 规则） */
	@media (max-width: 767px) {
		.topbar {
			padding-inline: 0.75rem;
		}
	}
</style>
